# =============================================================================
# Hermes EA — environment
#
# Copy to .env and fill in. The app STARTS without these and shows a setup
# screen listing what is missing, so you can do them in any order.
#
#   cp .env.example .env
#   npm run gen:secrets     # fills SESSION_SECRET and ENCRYPTION_KEY
# =============================================================================

NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
APP_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# 1. Microsoft Entra ID  —  https://entra.microsoft.com
# -----------------------------------------------------------------------------
# App registrations > New registration
#   Name:                Hermes EA
#   Account types:       Accounts in this organizational directory only
#   Redirect URI:        Web  ->  http://localhost:4000/api/auth/callback
#
# Then: Certificates & secrets > New client secret  (copy the VALUE, not the ID)
# Then: API permissions > Add > Microsoft Graph > Delegated:
#   User.Read  MailboxSettings.Read  Mail.Read  Calendars.Read
#   Contacts.Read  People.Read  offline_access
# Then: Grant admin consent
#
# Overview page has the Client ID and Tenant ID.

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/auth/callback


# -----------------------------------------------------------------------------
# 2. Who may sign in
# -----------------------------------------------------------------------------
# Start with the TEST mailbox, not the Director's. Add hers when it is proven.
# Anyone not listed is refused, even inside your own tenant.

PRIMARY_USER_EMAIL=
ALLOWED_USERS=


# -----------------------------------------------------------------------------
# 3. Database  —  https://supabase.com/dashboard
# -----------------------------------------------------------------------------
# New project (free tier). Then:
#   Project Settings > Database > Connection string > URI
# Use the "Transaction pooler" string and replace [YOUR-PASSWORD].
#
# Leave blank to run with in-memory storage — fine for a first login test,
# but everything is lost when the server restarts.

DATABASE_URL=


# -----------------------------------------------------------------------------
# 4. Secrets  —  run: npm run gen:secrets
# -----------------------------------------------------------------------------
# ENCRYPTION_KEY protects Microsoft refresh tokens at rest.
# Changing it invalidates every stored connection and forces a re-sign-in.

SESSION_SECRET=
ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# 5. AI  —  local Hermes by default
# -----------------------------------------------------------------------------
#   winget install Ollama.Ollama
#   ollama pull hermes3:8b
#
# Nothing else needs changing to run locally. To move to a hosted model later,
# change these three lines only — no code changes anywhere.
#
#   OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1
#                AI_MODEL=nousresearch/hermes-4-70b
#                AI_API_KEY=sk-or-...

AI_PROVIDER=openai-compatible
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=hermes3:8b
AI_API_KEY=ollama

LOG_LEVEL=info
