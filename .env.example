# Copy this file to .env. Missing values are reported on the setup screen.

NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
APP_URL=http://localhost:5173
COOKIE_SAME_SITE=lax

# Microsoft Entra ID: https://entra.microsoft.com
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/auth/callback

# Only these mailboxes may sign in.
PRIMARY_USER_EMAIL=
ALLOWED_USERS=

# Supabase transaction-pooler connection string. Optional for initial testing,
# required when NODE_ENV=production.
DATABASE_URL=

# Generate both with: npm run gen:secrets. They must be different. Both are
# required when NODE_ENV=production.
SESSION_SECRET=
ENCRYPTION_KEY=

# Official OpenAI API: https://platform.openai.com/api-keys
# Add API credits, create a secret key, and keep it server-side.
OPENAI_API_KEY=
# Purpose-based policy. Routine work stays quick; executive work and briefings
# use Sol with medium reasoning. Interactive roles use Fast processing.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_EXECUTIVE_MODEL=gpt-5.6-sol
OPENAI_BRIEFING_MODEL=gpt-5.6-sol
OPENAI_BACKGROUND_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_FAST_REASONING_EFFORT=none
OPENAI_EXECUTIVE_REASONING_EFFORT=medium
OPENAI_BRIEFING_REASONING_EFFORT=medium
OPENAI_BACKGROUND_REASONING_EFFORT=none
OPENAI_SERVICE_TIER=default
OPENAI_FAST_SERVICE_TIER=fast
OPENAI_EXECUTIVE_SERVICE_TIER=fast
OPENAI_BRIEFING_SERVICE_TIER=fast
OPENAI_BACKGROUND_SERVICE_TIER=default
OPENAI_MONTHLY_BUDGET_USD=10
# Category caps reserve the briefing allowance from interactive work.
OPENAI_INTERACTIVE_BUDGET_USD=8
OPENAI_BRIEFING_BUDGET_USD=2
# Background model calls remain disabled until this is set above zero.
OPENAI_BACKGROUND_BUDGET_USD=0

# Adaptive response ceilings: short routine answers, more room for executive work.
HERMES_RESPONSE_MODES=true

# Controlled proactive engine. Dashboard scans are read-only and produce only
# in-app notices. Background Graph polling is off until explicitly enabled.
HERMES_PROACTIVE_DELIVERY=notify
HERMES_PROACTIVE_BACKGROUND=false
HERMES_PROACTIVE_INTERVAL_MINUTES=15
HERMES_EDGE_RUNTIME=false

LOG_LEVEL=info
DEMO_MODE=false
